{
  "venvPath": ".",
  "venv": "venv",
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "include": [
    "resumes",
    "resume_api"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/migrations",
    "**/staticfiles"
  ],
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": false,
  "typeCheckingMode": "basic"
}
